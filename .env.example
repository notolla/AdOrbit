# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google Gemini AI
VITE_GOOGLE_AI_API_KEY=
GOOGLE_AI_API_KEY=
VITE_GOOGLE_AI_API_KEY_BACKUP=
GOOGLE_AI_API_KEY_BACKUP=

# Google Ads API — Keyword Planner (gerçek CPC & hacim) + OAuth hesap bağlama
# Kurulum: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# OAuth callback (opsiyonel — varsayılan: {origin}/api/google-ads/oauth/callback)
GOOGLE_ADS_REDIRECT_URI=
# Sunucu tarafı servis hesabı (opsiyonel — kullanıcı OAuth yoksa fallback)
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# MCC hesabı kullanıyorsanız (opsiyonel):
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Varsayılan: v22 (v18–v21 REST uçları kaldırıldı)
GOOGLE_ADS_API_VERSION=v22
# Push aktarımında günlük bütçe (TRY, varsayılan 50)
GOOGLE_ADS_DEFAULT_DAILY_BUDGET_TRY=50
